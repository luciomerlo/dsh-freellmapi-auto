# dsh-freellmapi-auto — environment example
#
# Copy to `.env` only for local experiments; DSH itself reads plugin config from
# the Cordis loader row, not from this file. Never commit a filled-in copy.

# Override the FreeLLMAPI data directory that holds `freeapi.db` and
# `.encryption-key`. Defaults to the platform user-data directory:
#   Windows: %APPDATA%\freellmapi
#   macOS:   ~/Library/Application Support/freellmapi
#   Linux:   ~/.config/freellmapi
FREELMAPI_HOME=

# Optional: bearer token for a FreeLLMAPI proxy used when directMode is off.
# Leave empty in a repository; set it in the DSH profile patch instead.
FREELMAPI_API_KEY=

# Optional: point the plugin at a running FreeLLMAPI proxy.
FREELMAPI_PROXY_URL=http://127.0.0.1:31415/v1
